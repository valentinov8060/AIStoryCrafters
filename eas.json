{
  "cli": {
    "version": ">= 14.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "distribution": "internal",
      "developmentClient": true
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_KEY_GROQ": "...",
        "EXPO_PUBLIC_KEY_SECURE_STORE_API_KEY_GROQ": "..."
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_KEY_GROQ": "...",
        "EXPO_PUBLIC_KEY_SECURE_STORE_API_KEY_GROQ": "..."
      }
    }
  },
  "submit": {
    "production": {}
  }
}
